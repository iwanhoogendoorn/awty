{
  "name": "awty",
  "version": "2.23.0",
  "description": "Travel Planner — plan holidays, day trips, concerts and events as markdown notes in Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node scripts/check-version.mjs && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node tests/smoke.test.mjs",
    "bump": "node scripts/bump-version.mjs",
    "gen:cities": "node scripts/generate-cities.mjs",
    "gen:airports": "node scripts/generate-airports.mjs",
    "gen:docs": "node scripts/generate-travel-docs.mjs",
    "install-local": "node scripts/install-local.mjs",
    "release": "node scripts/release.mjs",
    "gen:worldmap": "node scripts/generate-worldmap.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "travel"
  ],
  "author": "Iwan Hoogendoorn",
  "license": "MIT",
  "devDependencies": {
    "@nwpr/airport-codes": "^3.0.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.11.0",
    "all-the-cities": "^3.1.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.21.5",
    "obsidian": "latest",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5",
    "tz-lookup": "^6.1.25"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  }
}
